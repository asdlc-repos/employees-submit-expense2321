{
  "version": 3,
  "permissions": [
    {
      "resource": "claims",
      "component": "expense-api",
      "description": "Expense claims and their approval",
      "actions": [
        { "handle": "read", "description": "The caller's own claims" },
        { "handle": "submit", "description": "Create, edit and submit the caller's own claims" },
        { "handle": "withdraw", "description": "Withdraw the caller's own undecided claim" },
        { "handle": "review-manager", "description": "Claims of the caller's direct reports" },
        { "handle": "approve", "description": "Approve a direct report's submitted claim" },
        { "handle": "reject", "description": "Reject a direct report's submitted claim with a reason" },
        { "handle": "read-all", "description": "Every submitted claim in the company" }
      ]
    },
    {
      "resource": "reports",
      "component": "expense-api",
      "description": "Company-wide claim reporting",
      "actions": [
        { "handle": "read", "description": "Totals by status" },
        { "handle": "export", "description": "Download the filtered claim list as CSV" }
      ]
    },
    {
      "resource": "exports",
      "component": "expense-api",
      "description": "Payroll export batches",
      "actions": [
        { "handle": "read", "description": "Pending summary and past batches" },
        { "handle": "create", "description": "Create a payroll export batch" },
        { "handle": "download", "description": "Download a batch file" }
      ]
    }
  ],
  "groups": [
    { "name": "Employees", "description": "Everyone who files expense claims" },
    { "name": "Managers", "description": "People who approve their direct reports' claims" },
    { "name": "Finance", "description": "Finance team: payroll export and reporting" }
  ],
  "roles": [
    {
      "name": "Employee",
      "description": "Files, edits, withdraws and follows their own expense claims.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F1.6", "F1.7", "F1.8"],
      "grants": ["claims:read", "claims:submit", "claims:withdraw"],
      "assignTo": ["Employees"]
    },
    {
      "name": "Manager",
      "description": "Reviews, approves and rejects claims of their direct reports.",
      "stories": ["F2.1", "F2.2", "F2.3", "F2.4", "F2.5", "F2.6"],
      "grants": ["claims:review-manager", "claims:approve", "claims:reject"],
      "assignTo": ["Managers"]
    },
    {
      "name": "FinanceOfficer",
      "description": "Finance team member: exports approved claims to payroll and reports on all claims.",
      "stories": ["F3.1", "F3.2", "F3.3", "F3.4", "F4.1", "F4.2", "F4.3", "F4.4", "F4.5"],
      "grants": ["claims:read-all", "reports:read", "reports:export", "exports:read", "exports:create", "exports:download"],
      "assignTo": ["Finance"]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "roles": ["Employee"] },
    { "username": "test-employee-2", "roles": ["Employee"] },
    { "username": "test-manager", "roles": ["Manager", "Employee"] },
    { "username": "test-finance-officer", "roles": ["FinanceOfficer"] }
  ]
}
